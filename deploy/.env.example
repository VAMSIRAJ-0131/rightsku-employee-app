# Copy to deploy/.env ON THE SERVER ONLY and fill in real values:
#   cp .env.example .env && chmod 600 .env
# deploy/.env is ignored by Git. Never commit it, paste it into chat or email it.
# Make random values with:  openssl rand -hex 32
# (hex has no $, quotes or spaces, which Docker Compose would misread).

# --- Required ---------------------------------------------------------------

# Database password (the database is never reachable from the internet).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Signs sign-in tokens. At least 32 characters. Changing it signs everyone out.
JWT_SECRET=replace-with-openssl-rand-hex-32

# Public API address (DNS A record -> this server) and the email Let's Encrypt
# uses for certificate notices.
API_DOMAIN=api.rightsku.com
ACME_EMAIL=replace-with-your-email

# --- First start only: create the HR Admin account (hr@rightsku.com) --------
# Set to true with a strong temporary password for ONE start, sign in once,
# then set it back to false (and delete the password line) and restart.
HR_ADMIN_BOOTSTRAP_ENABLED=false
# HR_ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional: "Forgot password" email --------------------------------------
# Leave these commented out to keep "Contact HR" instead. Uncomment ALL of them
# to turn it on (e.g. Brevo's free SMTP plan).
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# PASSWORD_RESET_MAIL_FROM=no-reply@rightsku.com

# --- Nightly backups (read by backup.sh; see README.md) ---------------------
# GPG key the backups are encrypted to. Only its PUBLIC key is on the server.
BACKUP_GPG_RECIPIENT=replace-with-key-fingerprint
# rclone remote and folder for the off-server copy, e.g. r2:rightsku-backups
BACKUP_RCLONE_REMOTE=
# How many backups to keep on this server, and how many days off-server.
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_REMOTE_DAYS=30
