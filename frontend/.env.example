# Copy to .env (testing) or .env.production (release builds). Never commit the real files.
#
# The backend's address, as the phone reaches it.
#   Testing on the office Wi-Fi:  VITE_API_BASE_URL=http://<laptop-ip>:8080   (debug APK only)
#   Production release:           VITE_API_BASE_URL=https://<production-api-host>
# "npm run build:release" refuses anything that is not a public HTTPS address.
VITE_API_BASE_URL=
